# StatusBar — Bottom status bar
# Minimal: Focus + Done stats, subtle top hairline, compact 22dp

<StatusBar>:
    orientation: "horizontal"
    size_hint_y: None
    height: "22dp"
    padding: ["16dp", "0dp", "16dp", "0dp"]
    spacing: "16dp"
    md_bg_color: 0.051, 0.051, 0.102, 1

    canvas.before:
        Color:
            rgba: 0.176, 0.176, 0.29, 0.2
        Line:
            width: 1
            points: [self.x, self.top - 0.5, self.right, self.top - 0.5]

    MDLabel:
        text: f"Focus {root.focus_time_display}"
        color: 0.353, 0.353, 0.502, 1
        font_size: "9sp"
        size_hint_x: None
        width: "80dp"

    MDLabel:
        text: f"Done {root.completed_display}"
        color: 0.353, 0.353, 0.502, 1
        font_size: "9sp"
        size_hint_x: None
        width: "70dp"

    Widget:

    MDLabel:
        text: root.hint_text
        color: 0.176, 0.176, 0.29, 0.8
        font_size: "8sp"
        size_hint_x: None
        width: "80dp"
        halign: "right"
