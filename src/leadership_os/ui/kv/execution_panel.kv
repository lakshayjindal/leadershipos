# ExecutionPanel — Right execution panel
# Refined: dominant timer, subtle borders, compact actions, meaningful progress
# KivyMD 2.0 compatible

<ExecutionPanel>:
    orientation: "vertical"
    size_hint_x: None
    width: "300dp"
    padding: ["16dp", "16dp", "16dp", "12dp"]
    spacing: "8dp"
    md_bg_color: 0.078, 0.078, 0.141, 1

    canvas.before:
        Color:
            rgba: 0.176, 0.176, 0.29, 0.3
        Line:
            width: 1
            points: [self.x + 0.5, self.y, self.x + 0.5, self.top]

    # ── Current Task ───────────────────────────────────────────────
    BoxLayout:
        orientation: "vertical"
        size_hint_y: None
        height: "52dp"
        spacing: "2dp"

        MDLabel:
            text: "CURRENT TASK"
            color: 0.353, 0.353, 0.502, 1
            font_size: "9sp"
            bold: True
            size_hint_y: None
            height: "14dp"

        MDLabel:
            text: root.current_task_title
            color: (0.91, 0.91, 0.94, 1) if root.current_task_title != "No active task" else (0.353, 0.353, 0.502, 1)
            font_size: "14sp"
            bold: True if root.current_task_title != "No active task" else False
            shorten: True
            size_hint_y: None
            height: "22dp"

        MDLabel:
            text: root.current_task_priority
            color: (0.545, 0.545, 0.663, 1) if root.current_task_priority else (0.353, 0.353, 0.502, 1)
            font_size: "10sp"
            size_hint_y: None
            height: "14dp"

    # ── Timer Section (dominant) ───────────────────────────────────
    BoxLayout:
        orientation: "vertical"
        size_hint_y: None
        height: "100dp"
        spacing: "4dp"
        padding: ["0dp", "8dp", "0dp", "0dp"]

        # Large monospace timer
        MDLabel:
            text: root.timer_display
            color: (0.29, 0.435, 0.647, 1) if root.timer_running else (0.545, 0.545, 0.663, 1)
            font_size: "48sp"
            bold: True
            halign: "center"
            valign: "middle"
            font_name: "RobotoMono-Regular"
            size_hint_y: 1

        # Elapsed / Estimated on one line
        BoxLayout:
            orientation: "horizontal"
            size_hint_y: None
            height: "16dp"
            spacing: "24dp"
            halign: "center"

            MDLabel:
                text: f"Elapsed: {root.session_elapsed}"
                color: 0.545, 0.545, 0.663, 1
                font_size: "10sp"
                halign: "right"
                size_hint_x: 0.5

            MDLabel:
                text: f"Est: {root.session_estimated}"
                color: 0.545, 0.545, 0.663, 1
                font_size: "10sp"
                size_hint_x: 0.5

    # ── Subdued Divider ────────────────────────────────────────────
    Widget:
        size_hint_y: None
        height: "1dp"
        canvas:
            Color:
                rgba: 0.176, 0.176, 0.29, 0.2
            Rectangle:
                pos: self.pos
                size: self.size

    # ── Progress Section (compact stats) ───────────────────────────
    BoxLayout:
        orientation: "vertical"
        size_hint_y: None
        height: "60dp"
        spacing: "6dp"

        BoxLayout:
            orientation: "horizontal"
            size_hint_y: None
            height: "16dp"
            spacing: "4dp"

            MDLabel:
                text: "TODAY'S PROGRESS"
                color: 0.353, 0.353, 0.502, 1
                font_size: "9sp"
                bold: True
                size_hint_x: 1

            MDLabel:
                text: root.progress_status
                color: 0.545, 0.545, 0.663, 1
                font_size: "10sp"
                size_hint_x: None
                width: "80dp"
                halign: "right"
                shorten: True

        # Bar
        Widget:
            size_hint_y: None
            height: "5dp"
            canvas:
                Color:
                    rgba: 0.176, 0.176, 0.29, 0.4
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [2.5]
                Color:
                    rgba: (0.357, 0.604, 0.42, 1) if root.total_count > 0 and root.completed_count >= root.total_count else (0.29, 0.435, 0.647, 1)
                RoundedRectangle:
                    pos: self.pos
                    size: [self.width * min(1.0, root.completed_count / max(1, root.total_count)), self.height]
                    radius: [2.5]

        # Stats row
        BoxLayout:
            orientation: "horizontal"
            size_hint_y: None
            height: "18dp"
            spacing: "8dp"

            MDLabel:
                text: f"Done: {int(root.completed_count)}"
                color: 0.357, 0.604, 0.42, 0.8
                font_size: "10sp"
                size_hint_x: 0.33

            MDLabel:
                text: f"Remaining: {int(root.total_count - root.completed_count)}"
                color: 0.545, 0.545, 0.663, 1
                font_size: "10sp"
                size_hint_x: 0.33
                halign: "center"

            MDLabel:
                text: f"Focus: {root.focus_time_display}"
                color: 0.545, 0.545, 0.663, 1
                font_size: "10sp"
                size_hint_x: 0.34
                halign: "right"

    # ── Subdued Divider ────────────────────────────────────────────
    Widget:
        size_hint_y: None
        height: "1dp"
        canvas:
            Color:
                rgba: 0.176, 0.176, 0.29, 0.2
            Rectangle:
                pos: self.pos
                size: self.size

    # ── Next Up ────────────────────────────────────────────────────
    BoxLayout:
        orientation: "vertical"
        size_hint_y: None
        height: "36dp"
        spacing: "2dp"

        MDLabel:
            text: "NEXT UP"
            color: 0.353, 0.353, 0.502, 1
            font_size: "9sp"
            bold: True
            size_hint_y: None
            height: "14dp"

        MDLabel:
            text: root.next_task_title if root.next_task_title else "—"
            color: (0.545, 0.545, 0.663, 1) if root.next_task_title else (0.353, 0.353, 0.502, 1)
            font_size: "12sp"
            italic: not root.next_task_title
            shorten: True
            size_hint_y: None
            height: "18dp"

    # ── Spacer ─────────────────────────────────────────────────────
    Widget:

    # ── Action Buttons (compact, close to content) ─────────────────
    BoxLayout:
        orientation: "vertical"
        size_hint_y: None
        height: "160dp"
        spacing: "6dp"

        # Complete — PRIMARY
        MDButton:
            style: "filled"
            disabled: root.panel_state not in ("working",)
            on_release: root.on_complete()
            size_hint_y: None
            height: "40dp"
            md_bg_color: (0.29, 0.435, 0.647, 0.2) if root.panel_state not in ("working",) else (0.29, 0.435, 0.647, 1)
            radius: [8]
            MDButtonText:
                text: "✓  Complete Task"
                color: (1, 1, 1, 0.3) if root.panel_state not in ("working",) else (1, 1, 1, 1)
                font_size: "13sp"

        # Pause — SECONDARY
        MDButton:
            style: "text"
            disabled: root.panel_state not in ("working",)
            on_release: root.on_pause()
            size_hint_y: None
            height: "34dp"
            md_bg_color: (0.176, 0.176, 0.29, 0.2) if root.panel_state in ("working",) else (0.176, 0.176, 0.29, 0.05)
            radius: [6]
            MDButtonText:
                text: "II  Pause"
                color: (0.545, 0.545, 0.663, 0.25) if root.panel_state not in ("working",) else (0.545, 0.545, 0.663, 1)
                font_size: "12sp"

        # Start Break — TERTIARY
        MDButton:
            style: "text"
            disabled: root.panel_state not in ("working",)
            on_release: root.on_start_break()
            size_hint_y: None
            height: "34dp"
            md_bg_color: (0.176, 0.176, 0.29, 0.2) if root.panel_state in ("working",) else (0.176, 0.176, 0.29, 0.05)
            radius: [6]
            MDButtonText:
                text: "☕  Start Break"
                color: (0.545, 0.545, 0.663, 0.25) if root.panel_state not in ("working",) else (0.545, 0.545, 0.663, 1)
                font_size: "12sp"

        # Resume — BREAK PRIMARY
        MDButton:
            style: "filled"
            disabled: root.panel_state not in ("break",)
            on_release: root.on_resume()
            size_hint_y: None
            height: "40dp"
            md_bg_color: (0.357, 0.604, 0.42, 0.15) if root.panel_state not in ("break",) else (0.357, 0.604, 0.42, 1)
            radius: [8]
            MDButtonText:
                text: "▶  Resume Work"
                color: (1, 1, 1, 0.3) if root.panel_state not in ("break",) else (1, 1, 1, 1)
                font_size: "13sp"

        # End Break — BREAK SECONDARY
        MDButton:
            style: "text"
            disabled: root.panel_state not in ("break",)
            on_release: root.on_end_break()
            size_hint_y: None
            height: "34dp"
            md_bg_color: (0.176, 0.176, 0.29, 0.15) if root.panel_state in ("break",) else (0.176, 0.176, 0.29, 0.05)
            radius: [6]
            MDButtonText:
                text: "■  End Break"
                color: (0.545, 0.545, 0.663, 0.25) if root.panel_state not in ("break",) else (0.545, 0.545, 0.663, 1)
                font_size: "12sp"
