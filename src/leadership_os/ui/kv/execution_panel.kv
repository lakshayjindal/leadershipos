# ExecutionPanel — Right execution panel
# Premium: card-grouped sections, dominant 72sp timer, 22sp stat numbers
# Refined: improved contrast (0.255→0.353, 0.353→0.455, 0.408→0.502),
#           disabled button visibility (0.15→0.3 text, 0.12→0.25 bg),
#           narrower 280dp width for better responsiveness
# KivyMD 2.0 compatible

<ExecutionPanel>:
    orientation: "vertical"
    size_hint_x: None
    width: "280dp"
    padding: ["12dp", "12dp", "12dp", "12dp"]
    spacing: "8dp"
    md_bg_color: 0.078, 0.078, 0.141, 1

    # ── CARD: Current Task ───────────────────────────────────────────
    BoxLayout:
        orientation: "vertical"
        size_hint_y: None
        height: "56dp" if root.current_task_title != "No active task" else "0dp"
        spacing: "4dp"
        padding: ["14dp", "10dp", "14dp", "10dp"]
        opacity: 1 if root.current_task_title != "No active task" else 0
        disabled: root.current_task_title == "No active task"

        canvas.before:
            Color:
                rgba: 0.094, 0.094, 0.165, 1
            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [10]
            Color:
                rgba: 0.176, 0.176, 0.29, 0.08
            Line:
                width: 1
                rounded_rectangle: [self.x, self.y, self.width, self.height, 10, 10]

        MDLabel:
            text: "CURRENT TASK"
            color: 0.455, 0.455, 0.6, 1
            font_size: "8sp"
            bold: True
            size_hint_y: None
            height: "12dp"

        MDLabel:
            text: root.current_task_title
            color: 0.91, 0.91, 0.94, 1
            font_size: "15sp"
            bold: True
            shorten: True
            size_hint_y: None
            height: "20dp"

        MDLabel:
            id: task_priority_label
            text: root.current_task_priority
            color: 0.502, 0.502, 0.722, 1
            font_size: "10sp"
            size_hint_y: None
            height: "14dp"

    # ── CARD: Current Task Empty Placeholder ─────────────────────────
    BoxLayout:
        id: empty_task_placeholder
        orientation: "vertical"
        size_hint_y: None
        height: "56dp" if root.current_task_title == "No active task" else "0dp"
        spacing: "2dp"
        padding: ["14dp", "14dp", "14dp", "14dp"]
        opacity: 1 if root.current_task_title == "No active task" else 0
        disabled: root.current_task_title != "No active task"

        canvas.before:
            Color:
                rgba: 0.094, 0.094, 0.165, 1
            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [10]
            Color:
                rgba: 0.176, 0.176, 0.29, 0.08
            Line:
                width: 1
                rounded_rectangle: [self.x, self.y, self.width, self.height, 10, 10]

        MDLabel:
            text: "No active task"
            color: 0.455, 0.455, 0.6, 1
            font_size: "13sp"
            size_hint_y: None
            height: "18dp"

        MDLabel:
            text: "Start one from Today's Plan"
            color: 0.353, 0.353, 0.502, 1
            font_size: "10sp"
            size_hint_y: None
            height: "14dp"

    # ── CARD: Focus Timer (dominant focal point) ─────────────────────
    BoxLayout:
        orientation: "vertical"
        size_hint_y: None
        height: "120dp"
        padding: ["14dp", "8dp", "14dp", "10dp"]
        spacing: 0

        canvas.before:
            Color:
                rgba: 0.094, 0.094, 0.165, 1
            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [10]
            Color:
                rgba: 0.176, 0.176, 0.29, 0.08
            Line:
                width: 1
                rounded_rectangle: [self.x, self.y, self.width, self.height, 10, 10]

        # Large timer — the visual centerpiece
        MDLabel:
            text: root.timer_display
            color: (0.29, 0.435, 0.647, 1) if root.timer_running else (0.502, 0.502, 0.722, 1)
            font_size: "72sp"
            bold: True
            halign: "center"
            valign: "middle"
            font_name: "RobotoMono-Regular"
            size_hint_y: None
            height: "72dp"

        # State label
        MDLabel:
            text: "FOCUSING" if root.timer_running else ("PAUSED" if root.panel_state in ("break",) else "IDLE")
            color: (0.4, 0.65, 0.45, 1) if root.timer_running else (0.455, 0.455, 0.6, 1)
            font_size: "10sp"
            bold: True
            halign: "center"
            size_hint_y: None
            height: "16dp"

        # Elapsed / remaining
        MDLabel:
            text: f"Elapsed {root.session_elapsed}  ·  Remain {root.session_estimated}"
            color: 0.353, 0.353, 0.502, 1
            font_size: "9sp"
            halign: "center"
            size_hint_y: None
            height: "14dp"

    # ── CARD: Progress ───────────────────────────────────────────────
    BoxLayout:
        orientation: "vertical"
        size_hint_y: None
        height: "96dp"
        padding: ["14dp", "10dp", "14dp", "10dp"]
        spacing: "6dp"

        canvas.before:
            Color:
                rgba: 0.094, 0.094, 0.165, 1
            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [10]
            Color:
                rgba: 0.176, 0.176, 0.29, 0.08
            Line:
                width: 1
                rounded_rectangle: [self.x, self.y, self.width, self.height, 10, 10]

        # Header row
        BoxLayout:
            orientation: "horizontal"
            size_hint_y: None
            height: "16dp"
            spacing: "4dp"

            MDLabel:
                text: "TODAY'S PROGRESS"
                color: 0.455, 0.455, 0.6, 1
                font_size: "8sp"
                bold: True
                size_hint_x: 1

            MDLabel:
                text: root.progress_status
                color: 0.502, 0.502, 0.722, 1
                font_size: "10sp"
                size_hint_x: None
                width: "90dp"
                halign: "right"
                shorten: True

        # Progress bar
        Widget:
            size_hint_y: None
            height: "4dp"
            canvas:
                Color:
                    rgba: 0.176, 0.176, 0.29, 0.2
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [2]
                Color:
                    rgba: (0.4, 0.65, 0.45, 1) if root.total_count > 0 and root.completed_count >= root.total_count else (0.29, 0.435, 0.647, 1)
                RoundedRectangle:
                    pos: self.pos
                    size: [max(4, self.width * min(1.0, root.completed_count / max(1, root.total_count))), self.height]
                    radius: [2]

        # Stat counters — numbers dominate
        BoxLayout:
            orientation: "horizontal"
            size_hint_y: None
            height: "42dp"
            spacing: "6dp"

            # Done
            BoxLayout:
                orientation: "vertical"
                size_hint_x: 0.333
                spacing: 0
                canvas:
                    Color:
                        rgba: 0.082, 0.082, 0.149, 1
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [6]
                    Color:
                        rgba: 0.4, 0.65, 0.45, 0.12
                    Line:
                        width: 1
                        rounded_rectangle: [self.x, self.y, self.width, self.height, 6, 6]

                Widget:
                    size_hint_y: None
                    height: "6dp"

                MDLabel:
                    text: str(int(root.completed_count))
                    color: 0.4, 0.65, 0.45, 1
                    font_size: "22sp"
                    bold: True
                    halign: "center"
                    size_hint_y: None
                    height: "26dp"

                MDLabel:
                    text: "Done"
                    color: 0.4, 0.65, 0.45, 0.5
                    font_size: "8sp"
                    halign: "center"
                    size_hint_y: None
                    height: "10dp"

            # Remaining
            BoxLayout:
                orientation: "vertical"
                size_hint_x: 0.333
                spacing: 0
                canvas:
                    Color:
                        rgba: 0.082, 0.082, 0.149, 1
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [6]
                    Color:
                        rgba: 0.29, 0.435, 0.647, 0.12
                    Line:
                        width: 1
                        rounded_rectangle: [self.x, self.y, self.width, self.height, 6, 6]

                Widget:
                    size_hint_y: None
                    height: "6dp"

                MDLabel:
                    text: str(int(max(0, root.total_count - root.completed_count)))
                    color: 0.29, 0.435, 0.647, 1
                    font_size: "22sp"
                    bold: True
                    halign: "center"
                    size_hint_y: None
                    height: "26dp"

                MDLabel:
                    text: "Left"
                    color: 0.29, 0.435, 0.647, 0.5
                    font_size: "8sp"
                    halign: "center"
                    size_hint_y: None
                    height: "10dp"

            # Focus
            BoxLayout:
                orientation: "vertical"
                size_hint_x: 0.334
                spacing: 0
                canvas:
                    Color:
                        rgba: 0.082, 0.082, 0.149, 1
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [6]
                    Color:
                        rgba: 0.502, 0.502, 0.722, 0.1
                    Line:
                        width: 1
                        rounded_rectangle: [self.x, self.y, self.width, self.height, 6, 6]

                Widget:
                    size_hint_y: None
                    height: "6dp"

                MDLabel:
                    text: root.focus_time_display
                    color: 0.502, 0.502, 0.722, 1
                    font_size: "22sp"
                    bold: True
                    halign: "center"
                    size_hint_y: None
                    height: "26dp"

                MDLabel:
                    text: "Focus"
                    color: 0.502, 0.502, 0.722, 0.5
                    font_size: "8sp"
                    halign: "center"
                    size_hint_y: None
                    height: "10dp"

    # ── CARD: Next Up (inline with progress) ─────────────────────────
    BoxLayout:
        orientation: "vertical"
        size_hint_y: None
        height: "42dp"
        padding: ["14dp", "8dp", "14dp", "8dp"]
        spacing: "2dp"

        canvas.before:
            Color:
                rgba: 0.094, 0.094, 0.165, 1
            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [10]
            Color:
                rgba: 0.176, 0.176, 0.29, 0.08
            Line:
                width: 1
                rounded_rectangle: [self.x, self.y, self.width, self.height, 10, 10]

        MDLabel:
            text: "NEXT UP"
            color: 0.455, 0.455, 0.6, 1
            font_size: "8sp"
            bold: True
            size_hint_y: None
            height: "12dp"

        MDLabel:
            text: root.next_task_title if root.next_task_title else "—"
            color: (0.502, 0.502, 0.722, 1) if root.next_task_title else (0.29, 0.29, 0.47, 1)
            font_size: "13sp"
            italic: not root.next_task_title
            shorten: True
            size_hint_y: None
            height: "18dp"

    # ── Spacer ───────────────────────────────────────────────────────
    Widget:
        size_hint_y: 0.3

    # ── CARD: Actions ────────────────────────────────────────────────
    BoxLayout:
        orientation: "vertical"
        size_hint_y: None
        height: "160dp"
        padding: ["14dp", "10dp", "14dp", "10dp"]
        spacing: "4dp"

        canvas.before:
            Color:
                rgba: 0.094, 0.094, 0.165, 1
            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [10]
            Color:
                rgba: 0.176, 0.176, 0.29, 0.08
            Line:
                width: 1
                rounded_rectangle: [self.x, self.y, self.width, self.height, 10, 10]

        MDLabel:
            text: "ACTIONS"
            color: 0.455, 0.455, 0.6, 1
            font_size: "8sp"
            bold: True
            size_hint_y: None
            height: "12dp"

        Widget:
            size_hint_y: None
            height: "2dp"

        # Complete — PRIMARY (filled blue)
        MDButton:
            style: "filled"
            disabled: root.panel_state not in ("working",)
            on_release: root.on_complete()
            size_hint_y: None
            height: "40dp"
            md_bg_color: (0.29, 0.435, 0.647, 0.25) if root.panel_state not in ("working",) else (0.29, 0.435, 0.647, 1)
            radius: [8]
            MDButtonText:
                text: "✓  Complete Task"
                color: (1, 1, 1, 0.3) if root.panel_state not in ("working",) else (1, 1, 1, 1)
                font_size: "13sp"
                padding: ["8dp", "6dp"]

        # Pause — SECONDARY (text style)
        MDButton:
            style: "text"
            disabled: root.panel_state not in ("working",)
            on_release: root.on_pause()
            size_hint_y: None
            height: "34dp"
            md_bg_color: (0.176, 0.176, 0.29, 0.15) if root.panel_state in ("working",) else (0.176, 0.176, 0.29, 0.08)
            radius: [6]
            MDButtonText:
                text: "II  Pause"
                color: (0.502, 0.502, 0.722, 0.3) if root.panel_state not in ("working",) else (0.502, 0.502, 0.722, 1)
                font_size: "12sp"
                padding: ["8dp", "6dp"]

        # Start Break — UTILITY (text style, muted)
        MDButton:
            style: "text"
            disabled: root.panel_state not in ("working",)
            on_release: root.on_start_break()
            size_hint_y: None
            height: "30dp"
            md_bg_color: (0.176, 0.176, 0.29, 0.1) if root.panel_state in ("working",) else (0.176, 0.176, 0.29, 0.06)
            radius: [6]
            MDButtonText:
                text: "☕  Start Break"
                color: (0.502, 0.502, 0.722, 0.3) if root.panel_state not in ("working",) else (0.502, 0.502, 0.722, 0.7)
                font_size: "11sp"
                padding: ["8dp", "6dp"]

        # Thin separator
        Widget:
            size_hint_y: None
            height: "1dp"
            canvas:
                Color:
                    rgba: 0.176, 0.176, 0.29, 0.05
                Rectangle:
                    pos: self.x + 20, self.y
                    size: [self.width - 40, 1]

        # Resume — BREAK PRIMARY (filled green)
        MDButton:
            style: "filled"
            disabled: root.panel_state not in ("break",)
            on_release: root.on_resume()
            size_hint_y: None
            height: "40dp"
            md_bg_color: (0.4, 0.65, 0.45, 0.2) if root.panel_state not in ("break",) else (0.4, 0.65, 0.45, 1)
            radius: [8]
            MDButtonText:
                text: "▶  Resume Work"
                color: (1, 1, 1, 0.3) if root.panel_state not in ("break",) else (1, 1, 1, 1)
                font_size: "13sp"
                padding: ["8dp", "6dp"]

        # End Break — BREAK SECONDARY
        MDButton:
            style: "text"
            disabled: root.panel_state not in ("break",)
            on_release: root.on_end_break()
            size_hint_y: None
            height: "30dp"
            md_bg_color: (0.176, 0.176, 0.29, 0.1) if root.panel_state in ("break",) else (0.176, 0.176, 0.29, 0.06)
            radius: [6]
            MDButtonText:
                text: "■  End Break"
                color: (0.502, 0.502, 0.722, 0.3) if root.panel_state not in ("break",) else (0.502, 0.502, 0.722, 0.7)
                font_size: "11sp"
                padding: ["8dp", "6dp"]
