# TimerDisplay — Large timer with optional progress ring
# KivyMD 2.0 compatible

<TimerDisplay>:
    orientation: "vertical"
    size_hint_y: None
    height: "160dp"
    spacing: "8dp"

    # Timer text
    MDLabel:
        text: root.time_text
        color: (0.29, 0.435, 0.647, 1) if root.is_running else (0.596, 0.596, 0.722, 1)
        font_size: "36sp"
        bold: True
        halign: "center"
        valign: "middle"
        font_name: "RobotoMono-Regular"

    # Progress ring (visible only when estimated_seconds > 0)
    RelativeLayout:
        size_hint_y: None
        height: "60dp" if root.estimated_seconds else 0
        opacity: 1 if root.estimated_seconds else 0

        ProgressRing:
            id: progress_ring
            pos_hint: {"center_x": 0.5, "center_y": 0.5}
            size_hint: None, None
            size: "50dp", "50dp"
            progress: root.progress
            ring_width: 3
