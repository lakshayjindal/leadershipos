# main.kv — Root layout for Leadership OS
# Refined: proper empty state sizing, fixed layout bugs, consistent spacing
# KivyMD 2.0 compatible

<MainLayout>:
    orientation: "vertical"
    md_bg_color: 0.051, 0.051, 0.102, 1  # #0D0D1A

    # ─── Top Bar ─────────────────────────────────────────────────────
    TopBar:
        id: top_bar
        size_hint_y: None
        height: "48dp"

    # ─── Main Content ─────────────────────────────────────────────────
    BoxLayout:
        orientation: "horizontal"
        spacing: 0

        # Sidebar
        Sidebar:
            id: sidebar
            app_state: app.current_state if hasattr(app, 'current_state') else "startup"

        # Center Workspace
        BoxLayout:
            orientation: "vertical"
            padding: ["24dp", "16dp", "24dp", "12dp"]
            spacing: 0
            md_bg_color: 0.051, 0.051, 0.102, 1

            # ── Header row: date + "Today's Plan" ───────────────────
            BoxLayout:
                orientation: "vertical"
                size_hint_y: None
                height: "48dp"
                spacing: "0dp"

                MDLabel:
                    id: date_label
                    text: "Today, July 20"
                    color: 0.408, 0.408, 0.627, 1
                    font_size: "10sp"
                    size_hint_y: None
                    height: "16dp"

                MDLabel:
                    text: "Today's Plan"
                    color: 0.91, 0.91, 0.94, 1
                    font_size: "18sp"
                    bold: True
                    size_hint_y: None
                    height: "26dp"

            Widget:
                size_hint_y: None
                height: "8dp"

            # ── Task Input (384dp) ───────────────────────────────────
            BoxLayout:
                orientation: "horizontal"
                size_hint_y: None
                height: "36dp"
                spacing: 0
                size_hint_x: None
                width: "384dp"

                MDTextField:
                    id: task_title_input
                    hint_text: "Write a task..."
                    mode: "outlined"
                    size_hint_x: 1
                    multiline: False
                    on_text_validate: app.on_task_submit()
                    md_bg_color: 0.102, 0.102, 0.18, 1
                    line_color_normal: 0.176, 0.176, 0.29, 0.4
                    line_color_focus: 0.29, 0.435, 0.647, 1
                    hint_text_color_normal: 0.353, 0.353, 0.502, 1
                    text_color_normal: 0.91, 0.91, 0.94, 1
                    foreground_color: 0.91, 0.91, 0.94, 1
                    radius: [8, 0, 0, 8]
                    font_size: "13sp"

                MDButton:
                    style: "filled"
                    size_hint_x: None
                    width: "36dp"
                    md_bg_color: 0.29, 0.435, 0.647, 1
                    radius: [0, 8, 8, 0]
                    on_release: app.on_task_submit()
                    MDButtonText:
                        text: "+"
                        color: 1, 1, 1, 1
                        font_size: "16sp"

            Widget:
                size_hint_y: None
                height: "8dp"

            # ── Focus Section ───────────────────────────────────────
            BoxLayout:
                id: focus_card
                orientation: "horizontal"
                size_hint_y: None
                height: "0dp"
                spacing: 0
                padding: ["14dp", "10dp", "14dp", "10dp"]
                opacity: 0
                disabled: True

                canvas.before:
                    Color:
                        rgba: 0.102, 0.102, 0.18, 1
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [10]

                # Accent bar
                Widget:
                    size_hint_x: None
                    width: "3dp"
                    canvas.before:
                        Color:
                            rgba: 0.29, 0.435, 0.647, 1
                        RoundedRectangle:
                            pos: self.x, self.y + 6
                            size: [3, self.height - 12]
                            radius: [1.5]

                Widget:
                    size_hint_x: None
                    width: "12dp"

                BoxLayout:
                    orientation: "vertical"
                    size_hint_x: 1
                    spacing: "2dp"

                    MDLabel:
                        text: "CURRENT FOCUS"
                        color: 0.408, 0.408, 0.627, 1
                        font_size: "9sp"
                        bold: True
                        size_hint_y: None
                        height: "14dp"

                    MDLabel:
                        id: focus_task_title
                        text: ""
                        color: 0.91, 0.91, 0.94, 1
                        font_size: "16sp"
                        bold: True
                        shorten: True
                        size_hint_y: None
                        height: "22dp"

                MDLabel:
                    id: focus_time_badge
                    text: "00:00"
                    color: 0.408, 0.408, 0.627, 1
                    font_size: "16sp"
                    bold: True
                    size_hint_x: None
                    width: "60dp"
                    halign: "right"
                    valign: "middle"

            # ── Empty State (premium card, properly sized) ───────────
            BoxLayout:
                id: empty_state_box
                orientation: "vertical"
                size_hint_y: None
                height: "196dp"
                spacing: "0dp"
                padding: ["20dp", "16dp", "20dp", "16dp"]

                canvas.before:
                    Color:
                        rgba: 0.082, 0.082, 0.149, 1
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [10]
                    Color:
                        rgba: 0.176, 0.176, 0.29, 0.12
                    Line:
                        width: 1
                        rounded_rectangle: [self.x, self.y, self.width, self.height, 10, 10]

                # Icon header
                MDIcon:
                    icon: "weather-sunny"
                    theme_icon_color: "Custom"
                    icon_color: 0.596, 0.596, 0.722, 1
                    font_size: "26sp"
                    size_hint_x: None
                    width: "30dp"
                    size_hint_y: None
                    height: "30dp"

                Widget:
                    size_hint_y: None
                    height: "12dp"

                MDLabel:
                    text: "Your workspace is clear"
                    color: 0.596, 0.596, 0.722, 1
                    font_size: "14sp"
                    bold: True
                    size_hint_y: None
                    height: "20dp"

                Widget:
                    size_hint_y: None
                    height: "6dp"

                MDLabel:
                    id: empty_state_label
                    text: "Add a task above to begin. Your focus timer and\nprogress will appear here as you work."
                    color: 0.353, 0.353, 0.502, 1
                    font_size: "11sp"
                    size_hint_y: None
                    height: "34dp"
                    line_height: 1.5

                Widget:
                    size_hint_y: None
                    height: "12dp"

                MDLabel:
                    text: "Quick tips"
                    color: 0.255, 0.255, 0.412, 1
                    font_size: "9sp"
                    bold: True
                    size_hint_y: None
                    height: "14dp"

                Widget:
                    size_hint_y: None
                    height: "4dp"

                MDLabel:
                    text: "  •  Press Enter to add a task"
                    color: 0.255, 0.255, 0.412, 1
                    font_size: "10sp"
                    size_hint_y: None
                    height: "16dp"

                MDLabel:
                    text: "  •  Click a task to start working on it"
                    color: 0.255, 0.255, 0.412, 1
                    font_size: "10sp"
                    size_hint_y: None
                    height: "16dp"

            # ── Subtle section divider ───────────────────────────────
            Widget:
                size_hint_y: None
                height: "1dp"
                canvas:
                    Color:
                        rgba: 0.176, 0.176, 0.29, 0.1
                    Rectangle:
                        pos: self.x + 2, self.y
                        size: [self.width - 4, 1]

            Widget:
                size_hint_y: None
                height: "8dp"

            # ── Tasks section header ────────────────────────────────
            BoxLayout:
                id: section_pending_header
                orientation: "horizontal"
                size_hint_y: None
                height: "20dp"
                spacing: "8dp"
                opacity: 0

                MDLabel:
                    text: "TASKS"
                    color: 0.408, 0.408, 0.627, 1
                    font_size: "9sp"
                    bold: True
                    size_hint_x: None
                    width: "40dp"

                Widget:
                    canvas:
                        Color:
                            rgba: 0.176, 0.176, 0.29, 0.1
                        Rectangle:
                            pos: self.x, self.y + 8
                            size: [self.width, 1]

            # ── Task List ───────────────────────────────────────────
            ScrollView:
                id: task_scroll
                do_scroll_x: False
                bar_width: "2dp"
                bar_color: 0.176, 0.176, 0.29, 0.15
                bar_inactive_color: 0.176, 0.176, 0.29, 0.04

                BoxLayout:
                    id: task_list_container
                    orientation: "vertical"
                    size_hint_y: None
                    height: self.minimum_height
                    spacing: "6dp"

            Widget:
                size_hint_y: None
                height: "8dp"

            # ── Completed section ───────────────────────────────────
            BoxLayout:
                id: section_completed_header
                orientation: "horizontal"
                size_hint_y: None
                height: "20dp"
                spacing: "8dp"
                opacity: 0

                MDLabel:
                    text: "COMPLETED"
                    color: 0.357, 0.604, 0.42, 0.45
                    font_size: "9sp"
                    bold: True
                    size_hint_x: None
                    width: "90dp"

                Widget:
                    canvas:
                        Color:
                            rgba: 0.176, 0.176, 0.29, 0.08
                        Rectangle:
                            pos: self.x, self.y + 8
                            size: [self.width, 1]

            BoxLayout:
                id: completed_container
                orientation: "vertical"
                size_hint_y: None
                height: self.minimum_height
                spacing: "4dp"

            # Bottom spacer
            Widget:
                size_hint_y: 1

        # Execution Panel
        ExecutionPanel:
            id: execution_panel

    # ─── Status Bar ──────────────────────────────────────────────────
    StatusBar:
        id: status_bar


# ─── TopBar (inline) ────────────────────────────────────────────────

<TopBar>:
    orientation: "horizontal"
    size_hint_y: None
    height: "48dp"
    padding: 0
    spacing: 0
    md_bg_color: 0.078, 0.078, 0.141, 1

    # Brand section
    BoxLayout:
        orientation: "horizontal"
        size_hint_x: None
        width: "180dp"
        padding: 0
        spacing: 0
        md_bg_color: 0.078, 0.078, 0.141, 1

        Widget:
            size_hint_x: None
            width: "3dp"
            canvas.before:
                Color:
                    rgba: 0.29, 0.435, 0.647, 1
                Rectangle:
                    pos: self.pos
                    size: self.size

        Widget:
            size_hint_x: None
            width: "12dp"

        MDLabel:
            text: "Leadership OS"
            color: 0.91, 0.91, 0.94, 1
            font_size: "11sp"
            bold: True
            valign: "middle"

    Widget:

    # Action buttons
    BoxLayout:
        orientation: "horizontal"
        size_hint_x: None
        width: "140dp"
        spacing: "2dp"
        padding: ["4dp", "4dp", "4dp", "4dp"]
        md_bg_color: 0.078, 0.078, 0.141, 1

        MDIconButton:
            icon: "magnify"
            theme_icon_color: "Custom"
            icon_color: 0.408, 0.408, 0.627, 1
            icon_size: "17sp"
            on_release: app.show_search()

        MDIconButton:
            icon: "cog"
            theme_icon_color: "Custom"
            icon_color: 0.408, 0.408, 0.627, 1
            icon_size: "17sp"
            on_release: app.switch_to_settings()

        MDIconButton:
            icon: "keyboard"
            theme_icon_color: "Custom"
            icon_color: 0.408, 0.408, 0.627, 1
            icon_size: "17sp"
            on_release: app.show_command_palette()
