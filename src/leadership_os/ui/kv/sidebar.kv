# Sidebar — Left navigation panel
# Refined: richer session info, stronger active state, reduced wasted space
# KivyMD 2.0 compatible

<Sidebar>:
    orientation: "vertical"
    size_hint_x: None
    width: "180dp"
    padding: ["8dp", "12dp", "8dp", "8dp"]
    spacing: "4dp"
    md_bg_color: 0.078, 0.078, 0.141, 1

    canvas.before:
        Color:
            rgba: 0.176, 0.176, 0.29, 0.3
        Line:
            width: 1
            points: [self.right - 0.5, self.y, self.right - 0.5, self.top]

    # Section label
    MDLabel:
        text: "NAVIGATION"
        color: 0.353, 0.353, 0.502, 1
        font_size: "9sp"
        bold: True
        size_hint_y: None
        height: "16dp"
        padding: ["10dp", 0, 0, 0]

    # Navigation items
    BoxLayout:
        orientation: "vertical"
        size_hint_y: None
        height: self.minimum_height
        spacing: "2dp"

        SidebarNavItem:
            text: "Today"
            icon: "calendar-today"
            active: 1 if root.app_state in ("planning", "working", "break", "idle", "review") else 0
            on_release: root.today_callback()

        SidebarNavItem:
            text: "History"
            icon: "history"
            on_release: root.history_callback()

        SidebarNavItem:
            text: "Settings"
            icon: "cog"
            on_release: root.settings_callback()

    # Spacer
    Widget:

    # ── Session Stats (rich bottom card) ───────────────────────────
    BoxLayout:
        orientation: "vertical"
        size_hint_y: None
        height: "120dp"
        padding: ["10dp", "8dp", "10dp", "8dp"]
        spacing: "4dp"

        # Top divider
        Widget:
            size_hint_y: None
            height: "1dp"
            canvas:
                Color:
                    rgba: 0.176, 0.176, 0.29, 0.3
                Rectangle:
                    pos: self.pos
                    size: self.size

        Widget:
            size_hint_y: None
            height: "6dp"

        MDLabel:
            text: "TODAY"
            color: 0.353, 0.353, 0.502, 1
            font_size: "9sp"
            bold: True
            size_hint_y: None
            height: "14dp"

        # Big progress number
        MDLabel:
            text: root.progress_display
            font_size: "24sp"
            color: 0.91, 0.91, 0.94, 1
            bold: True
            size_hint_y: None
            height: "30dp"

        # Stats row
        BoxLayout:
            orientation: "horizontal"
            size_hint_y: None
            height: "16dp"
            spacing: "8dp"

            MDLabel:
                text: f"Focus: {root.focus_display}"
                font_size: "10sp"
                color: 0.545, 0.545, 0.663, 1
                size_hint_x: 0.5

            MDLabel:
                text: f"Tasks: {int(root.total_count)}"
                font_size: "10sp"
                color: 0.545, 0.545, 0.663, 1
                size_hint_x: 0.5
                halign: "right"

        # Status line
        MDLabel:
            id: status_line
            text: "Ready" if root.app_state in ("planning", "idle", "startup") else ("Working" if root.app_state == "working" else ("On Break" if root.app_state == "break" else "Reviewing"))
            font_size: "10sp"
            color: (0.357, 0.604, 0.42, 1) if root.app_state == "working" else (0.353, 0.353, 0.502, 1)
            size_hint_y: None
            height: "16dp"
            bold: True


<SidebarNavItem>:
    size_hint_y: None
    height: "38dp"
    spacing: "10dp"
    padding: ["10dp", 0, "10dp", 0]

    canvas.before:
        Color:
            rgba: (0.176, 0.176, 0.29, 1) if root.active else (0.078, 0.078, 0.141, 1)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [6]

    # Active accent bar (left edge)
    canvas.after:
        Color:
            rgba: (0.29, 0.435, 0.647, 1) if root.active else (0, 0, 0, 0)
        RoundedRectangle:
            pos: self.x, self.y + 8
            size: [3, self.height - 16]
            radius: [1.5]

    MDIcon:
        icon: root.icon
        color: (0.29, 0.435, 0.647, 1) if root.active else (0.545, 0.545, 0.663, 1)
        size_hint_x: None
        width: "20dp"
        font_size: "16sp"

    MDLabel:
        text: root.text
        color: 0.91, 0.91, 0.94, 1
        font_size: "12sp"
        bold: root.active
