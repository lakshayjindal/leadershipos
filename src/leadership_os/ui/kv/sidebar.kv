# Sidebar — Left navigation panel
# Refined: compact nav, clean alignment, session bottom card
# KivyMD 2.0 compatible

<Sidebar>:
    orientation: "vertical"
    size_hint_x: None
    width: "180dp"
    padding: ["8dp", "12dp", "8dp", "8dp"]
    spacing: "2dp"
    md_bg_color: 0.078, 0.078, 0.141, 1

    # Section label
    MDLabel:
        text: "NAVIGATION"
        color: 0.353, 0.353, 0.502, 1
        font_size: "9sp"
        bold: True
        size_hint_y: None
        height: "18dp"
        padding: ["10dp", 0, 0, 0]

    # Navigation items
    BoxLayout:
        orientation: "vertical"
        size_hint_y: None
        height: self.minimum_height
        spacing: "2dp"

        SidebarNavItem:
            text: "Today"
            icon: "calendar-today"
            active: 1 if root.app_state in ("planning", "working", "break", "idle", "review") else 0
            on_release: root.today_callback()

        SidebarNavItem:
            text: "History"
            icon: "history"
            on_release: root.history_callback()

        SidebarNavItem:
            text: "Settings"
            icon: "cog"
            on_release: root.settings_callback()

    Widget:

    # ── Session Stats (bottom card) ─────────────────────────────────
    BoxLayout:
        orientation: "vertical"
        size_hint_y: None
        height: "140dp"
        padding: ["10dp", "10dp", "10dp", "10dp"]
        spacing: "6dp"

        canvas.before:
            Color:
                rgba: 0.082, 0.082, 0.149, 1
            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [8]

        MDLabel:
            text: "TODAY"
            color: 0.353, 0.353, 0.502, 1
            font_size: "9sp"
            bold: True
            size_hint_y: None
            height: "14dp"

        MDLabel:
            text: root.progress_display
            font_size: "24sp"
            color: 0.91, 0.91, 0.94, 1
            bold: True
            size_hint_y: None
            height: "30dp"

        Widget:
            size_hint_y: None
            height: "1dp"
            canvas:
                Color:
                    rgba: 0.176, 0.176, 0.29, 0.12
                Rectangle:
                    pos: self.pos
                    size: self.size

        BoxLayout:
            orientation: "horizontal"
            size_hint_y: None
            height: "18dp"
            spacing: "4dp"

            MDLabel:
                text: f"Focus {root.focus_display}"
                font_size: "10sp"
                color: 0.408, 0.408, 0.627, 1
                size_hint_x: 0.5

            MDLabel:
                text: f"Tasks {int(root.total_count)}"
                font_size: "10sp"
                color: 0.408, 0.408, 0.627, 1
                size_hint_x: 0.5
                halign: "right"

        BoxLayout:
            orientation: "horizontal"
            size_hint_y: None
            height: "20dp"
            spacing: "6dp"
            padding: [0, "2dp", 0, 0]

            MDIcon:
                icon: "circle"
                size_hint_x: None
                width: "6dp"
                font_size: "6sp"
                pos_hint: {"center_y": 0.5}
                theme_icon_color: "Custom"
                icon_color: (0.357, 0.604, 0.42, 1) if root.app_state == "working" else (0.29, 0.435, 0.647, 0.5) if root.app_state in ("planning", "idle", "startup") else (0.769, 0.357, 0.357, 1)

            MDLabel:
                id: status_line
                text: "Ready" if root.app_state in ("planning", "idle", "startup") else ("Focusing" if root.app_state == "working" else ("On Break" if root.app_state == "break" else "Reviewing"))
                font_size: "10sp"
                color: (0.91, 0.91, 0.94, 1) if root.app_state == "working" else (0.408, 0.408, 0.627, 1)
                size_hint_y: None
                height: "16dp"
                bold: True if root.app_state == "working" else False


<SidebarNavItem>:
    size_hint_y: None
    height: "34dp"
    spacing: "8dp"
    padding: ["10dp", 0, "10dp", 0]

    canvas.before:
        Color:
            rgba: (0.157, 0.157, 0.282, 1) if root.active else (0.078, 0.078, 0.141, 1)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [6]

    canvas.after:
        Color:
            rgba: (0.29, 0.435, 0.647, 1) if root.active else (0, 0, 0, 0)
        RoundedRectangle:
            pos: self.x, self.y + 5
            size: [3, self.height - 10]
            radius: [1.5]

    MDIcon:
        icon: root.icon
        color: (0.29, 0.435, 0.647, 1) if root.active else (0.408, 0.408, 0.627, 1)
        size_hint_x: None
        width: "18dp"
        font_size: "15sp"
        pos_hint: {"center_y": 0.5}

    MDLabel:
        text: root.text
        color: (0.91, 0.91, 0.94, 1) if root.active else (0.596, 0.596, 0.722, 1)
        font_size: "12sp"
        bold: root.active
        pos_hint: {"center_y": 0.5}
