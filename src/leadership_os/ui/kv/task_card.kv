# TaskCard — Single task display card
# Refined: improved text contrast (0.408→0.502)
# KivyMD 2.0 compatible

<TaskCard>:
    orientation: "horizontal"
    size_hint_y: None
    height: "48dp"
    padding: 0
    spacing: 0
    md_bg_color: 0.082, 0.082, 0.149, 1

    canvas.before:
        Color:
            rgba: 0.176, 0.176, 0.29, 0.18
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [8]

    # ── Left accent strip ──────────────────────────────────────────
    Widget:
        size_hint_x: None
        width: "3dp"
        canvas.before:
            Color:
                rgba: root.priority_rgba
            RoundedRectangle:
                pos: self.x, self.y + 6
                size: [3, self.height - 12]
                radius: [1.5]

    Widget:
        size_hint_x: None
        width: "8dp"

    # ── Status icon ────────────────────────────────────────────────
    MDIconButton:
        icon: root.status_icon
        theme_icon_color: "Custom"
        icon_color: root.status_rgba
        size_hint_x: None
        width: "28dp"
        icon_size: "16sp"
        pos_hint: {"center_y": 0.5}
        on_release: root.on_activate() if not root.is_active else root.on_complete()

    Widget:
        size_hint_x: None
        width: "6dp"

    # ── Content ────────────────────────────────────────────────────
    BoxLayout:
        orientation: "vertical"
        size_hint_x: 1
        pos_hint: {"center_y": 0.5}
        padding: ["0dp", "6dp", "0dp", "6dp"]
        spacing: "2dp"

        # Title row
        MDLabel:
            text: root.title
            color: (0.91, 0.91, 0.94, 1) if not root.is_completed else (0.502, 0.502, 0.722, 0.6)
            font_size: "12sp"
            bold: root.is_active
            shorten: True
            size_hint_y: None
            height: "18dp"

        # Meta row
        BoxLayout:
            orientation: "horizontal"
            size_hint_y: None
            height: "16dp"
            spacing: "6dp"

            # Priority badge
            BoxLayout:
                size_hint_x: None
                width: "58dp"
                padding: 0
                canvas:
                    Color:
                        rgba: root.priority_bg_rgba
                    RoundedRectangle:
                        pos: self.x, self.y
                        size: [self.width, 16]
                        radius: [8]
                MDLabel:
                    text: root.priority_label
                    color: root.priority_rgba
                    font_size: "8sp"
                    bold: True
                    halign: "center"
                    valign: "middle"
                    size_hint_y: None
                    height: "16dp"
                    shorten: True
                    max_lines: 1

            # Time
            MDLabel:
                text: root.time_display
                color: 0.502, 0.502, 0.722, 1 if root.time_display else 0
                font_size: "10sp"
                size_hint_x: None
                width: "70dp"
                shorten: True

            # Deadline
            MDLabel:
                text: root.deadline if root.deadline else ""
                color: (0.769, 0.357, 0.357, 1) if root.deadline else (0, 0, 0, 0)
                font_size: "10sp"
                size_hint_x: None
                width: "80dp" if root.deadline else 0
                shorten: True

    # ── Action icons ───────────────────────────────────────────────
    BoxLayout:
        orientation: "horizontal"
        size_hint_x: None
        width: "48dp"
        padding: ["0dp", "0dp", "6dp", "0dp"]
        spacing: "0dp"
        pos_hint: {"center_y": 0.5}

        MDIconButton:
            icon: "pencil"
            theme_icon_color: "Custom"
            icon_color: 0.29, 0.29, 0.47, 1
            size_hint_x: None
            width: "22dp"
            icon_size: "13sp"
            on_release: root.on_edit()

        MDIconButton:
            icon: "delete"
            theme_icon_color: "Custom"
            icon_color: 0.29, 0.29, 0.47, 1
            size_hint_x: None
            width: "22dp"
            icon_size: "13sp"
            on_release: root.on_delete()
