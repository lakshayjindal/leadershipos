# TaskForm — Task creation/edit form
# KivyMD 2.0 compatible

<TaskForm>:
    orientation: "vertical"
    size_hint_y: None
    height: self.minimum_height
    padding: "16dp"
    spacing: "8dp"
    md_bg_color: 0.137, 0.137, 0.251, 1

    canvas.before:
        Color:
            rgba: 0.227, 0.227, 0.361, 1
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [8]

    # Title input (required)
    MDTextField:
        id: title_input
        hint_text: "Task title..."
        text: root.title
        on_text: root.title = self.text
        mode: "rectangle"
        size_hint_y: None
        height: "48dp"
        max_text_length: 200

    # Advanced toggle
    MDButton:
        style: "text"
        on_release: root.toggle_advanced()
        size_hint_y: None
        height: "32dp"
        MDButtonText:
            text: "Advanced options" if not root.advanced_visible else "Hide options"
            color: 0.596, 0.596, 0.722, 1
            font_size: "11sp"

    # Advanced fields (collapsible)
    BoxLayout:
        orientation: "vertical"
        size_hint_y: None
        height: self.minimum_height if root.advanced_visible else 0
        opacity: 1 if root.advanced_visible else 0
        spacing: "8dp"

        MDTextField:
            hint_text: "Estimated minutes (optional)"
            text: str(root.estimated_minutes) if root.estimated_minutes else ""
            on_text: root.estimated_minutes = int(self.text) if self.text.isdigit() else 0
            mode: "rectangle"
            input_filter: "int"
            size_hint_y: None
            height: "48dp"

        MDTextField:
            hint_text: "Deadline (optional)"
            text: root.deadline
            on_text: root.deadline = self.text
            mode: "rectangle"
            size_hint_y: None
            height: "48dp"

        MDTextField:
            hint_text: "Notes (optional)"
            text: root.notes
            on_text: root.notes = self.text
            mode: "rectangle"
            multiline: True
            size_hint_y: None
            height: "80dp"

    # Action buttons
    BoxLayout:
        orientation: "horizontal"
        size_hint_y: None
        height: "40dp"
        spacing: "8dp"

        Widget:

        MDButton:
            style: "text"
            on_release: root.cancel()
            size_hint_x: None
            width: "80dp"
            MDButtonText:
                text: "Cancel"

        MDButton:
            style: "filled"
            on_release: root.submit()
            size_hint_x: None
            width: "100dp"
            md_bg_color: 0.29, 0.435, 0.647, 1
            MDButtonText:
                text: root.submit_label
